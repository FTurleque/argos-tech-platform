# URL du serveur ARGOS. Par défaut : http://localhost:8080 (quarkus:dev).
# Vide : IHM servie par le serveur lui-même (image Docker), appels relatifs.
VITE_ARGOS_API_URL=http://localhost:8080
# L'émetteur OIDC et le client public de l'IHM ne se règlent pas ici : l'IHM les lit au démarrage dans la
# réponse publique de GET /api/v1/system/info du serveur (réglage serveur ARGOS_OIDC_ISSUER_PUBLIC ;
# quarkus:dev : royaume des Dev Services, http://localhost:8180/realms/argos).
