# URL du serveur ARGOS. Par défaut : http://localhost:8080 (quarkus:dev).
VITE_ARGOS_API_URL=http://localhost:8080
# Émetteur OIDC : royaume Keycloak « argos ». Par défaut : http://localhost:8180/realms/argos
# (Keycloak des Dev Services de quarkus:dev, port fixé à 8180).
VITE_ARGOS_OIDC_ISSUER=http://localhost:8180/realms/argos
# Client public OIDC de l'IHM (Authorization Code + PKCE S256).
VITE_ARGOS_OIDC_CLIENT_ID=argos-ui
