      "redirectUris": ["http://localhost:5173/*", "app://argos/*"],
      "webOrigins": ["http://localhost:5173", "app://argos"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "audience-argos-server",
          "protocol": "openid-connect",
