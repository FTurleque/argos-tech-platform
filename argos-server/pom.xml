<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.argos</groupId>
  <artifactId>argos-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>ARGOS — serveur</name>
  <description>Monolithe modulaire Quarkus d'ARGOS (ADR-0001, ADR-0019)</description>

  <properties>
    <!-- ADR-0019 : Java 17 minimum. Quarkus 3.40 est la dernière LTS 3.x (support jusqu'au 30/09/2027) ;
         Quarkus 4 exigera Java 21. -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.40.1.2</quarkus.platform.version>
    <archunit.version>1.5.1</archunit.version>
    <quarkus-mcp-server.version>2.0.4</quarkus-mcp-server.version>
    <rome.version>2.1.0</rome.version>
    <jsoup.version>1.24.1</jsoup.version>
    <maven-artifact.version>3.9.16</maven-artifact.version>
    <compiler-plugin.version>3.16.0</compiler-plugin.version>
    <surefire-plugin.version>3.5.3</surefire-plugin.version>
    <!-- Inventaire des dépendances tierces et de leurs licences (profil « licences », décision F3 du
         porteur du projet, 2026-11-19). CycloneDX Maven Plugin, licence Apache-2.0. -->
    <cyclonedx-plugin.version>2.9.3</cyclonedx-plugin.version>
    <!-- Lancement du script de vérification des licences dans le même profil. Licence Apache-2.0. -->
    <exec-plugin.version>3.6.4</exec-plugin.version>
    <skipITs>true</skipITs>
    <!-- Garde du JDK de build (maven-enforcer, licence Apache-2.0) : Java 17 ou plus par défaut ; le profil
         « integration-continue » resserre la plage sur le JDK de l'image d'exécution (eclipse-temurin:17-jre). -->
    <enforcer-plugin.version>3.7.0</enforcer-plugin.version>
    <argos.jdk.plage>[17,)</argos.jdk.plage>
    <!-- Couverture des tests (JaCoCo, licence EPL-2.0, outillage de build non livré). Version alignée sur
         l'agent org.jacoco géré par le BOM Quarkus, que l'extension quarkus-jacoco utilise : elle change avec
         Quarkus (Renovate ne la propose pas seule). Seuil global
         bloquant : 85 % des lignes, 70 % des branches (décision du porteur du projet, 2026-11-24). -->
    <jacoco-plugin.version>0.8.15</jacoco-plugin.version>
    <argos.couverture.lignes>0.85</argos.couverture.lignes>
    <argos.couverture.branches>0.70</argos.couverture.branches>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- API REST + OpenAPI (ADR-0019) -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-openapi</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-health</artifactId>
    </dependency>
    <!-- Observabilité (ADR-0036, EXP-13, EXP-14) : journaux JSON en production et métriques Micrometer au
         format Prometheus sur /q/metrics. Extensions de la plateforme Quarkus, licence Apache-2.0
         (ADR-0021 point 6). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-logging-json</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Identité de l'utilisateur courant (@Authenticated, SecurityIdentity). Le mécanisme
         d'authentification lui-même (OIDC, ADR-0008) est hors de ce socle. Apache-2.0. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-security</artifactId>
    </dependency>

    <!-- PostgreSQL (ADR-0002). Migrations Flyway appliquées au démarrage (ADR-0032, Accepté). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Authentification OIDC (ADR-0008, ADR-0027) : validation des jetons du fournisseur
         d'identité Keycloak. Licence Apache-2.0 (ADR-0021 point 6). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc</artifactId>
    </dependency>

    <!-- Alertes et résumés (changement diffuser-alertes-et-digests) : envoi des e-mails par le relais
         SMTP du Synology (Q-1). Extension Quarkus, licence Apache-2.0 (ADR-0021 point 6). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-mailer</artifactId>
    </dependency>
    <!-- Planification des résumés et des nouvelles tentatives d'envoi (diffuser-alertes-et-digests)
         et de la collecte horaire de la veille web (ADR-0028). Apache-2.0. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-scheduler</artifactId>
    </dependency>

    <!-- Serveur MCP en lecture seule, transport Streamable HTTP (ADR-0014, changement
         exposer-serveur-mcp). Extension Quarkiverse, licence Apache-2.0 (ADR-0021 point 6). -->
    <dependency>
      <groupId>io.quarkiverse.mcp</groupId>
      <artifactId>quarkus-mcp-server-http</artifactId>
      <version>${quarkus-mcp-server.version}</version>
    </dependency>

    <!-- Veille RSS/Atom et pages surveillées (ADR-0028, collecteur intégré) : licences enregistrées
         à l'introduction (ADR-0021 point 6). -->
    <!-- Lecture RSS 0.9x/1.0/2.0 et Atom. Apache-2.0 ; dépendances transitives : rome-utils
         (Apache-2.0), jdom2 (licence JDOM, de type Apache/BSD), slf4j-api (MIT). -->
    <dependency>
      <groupId>com.rometools</groupId>
      <artifactId>rome</artifactId>
      <version>${rome.version}</version>
    </dependency>
    <!-- Extraction du texte des pages HTML et nettoyage du contenu des flux. MIT. -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>${jsoup.version}</version>
    </dependency>

    <!-- Ordre des versions Maven pour la corrélation (décision E3 du porteur du projet, 2026-11-19) :
         org.apache.maven.artifact.versioning.ComparableVersion. Licence Apache-2.0 (pom parent
         org.apache:apache, LICENSE et NOTICE du jar ; ADR-0021 points 4 et 6), avis NOTICE reproduit
         dans argos-server/NOTICE. plexus-utils (Apache-2.0) exclu : ComparableVersion ne l'utilise pas. -->
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-artifact</artifactId>
      <version>${maven-artifact.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.codehaus.plexus</groupId>
          <artifactId>plexus-utils</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Jetons de test émis par le Keycloak des Dev Services. Licence Apache-2.0. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-keycloak-server</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @TestSecurity : utilisateur simulé dans les tests d'API. Apache-2.0. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Couverture des classes chargées par @QuarkusTest (jacoco-quarkus.exec). Apache-2.0. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jacoco</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Attente bornée d'une condition dans les tests, sans sommeil fixe (arc42 §8.11). Version gérée par le BOM
         Quarkus, licence Apache-2.0. -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
        <configuration>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>garde-jdk</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>${argos.jdk.plage}</version>
                  <message>JDK hors de la plage ${argos.jdk.plage} (production : JRE 17, ADR-0019).</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Les tests sans @QuarkusTest passent par l'agent de prepare-agent ; les classes chargées par le
           QuarkusClassLoader sont instrumentées par quarkus-jacoco. Les deux écrivent dans le même fichier,
           dont report et check tirent le rapport (target/site/jacoco) et le seuil, en phase verify. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-plugin.version}</version>
        <executions>
          <execution>
            <id>agent-couverture</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
              <destFile>${project.build.directory}/jacoco-quarkus.exec</destFile>
              <append>true</append>
            </configuration>
          </execution>
          <execution>
            <id>rapport-couverture</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-quarkus.exec</dataFile>
            </configuration>
          </execution>
          <execution>
            <id>seuil-couverture</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-quarkus.exec</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${argos.couverture.lignes}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${argos.couverture.branches}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Build de l'intégration continue (.github/workflows/integration-continue.yml) : JDK de la plage de
         production seulement (AUD-TST-19). Activation : mvn -P integration-continue ... -->
    <profile>
      <id>integration-continue</id>
      <properties>
        <argos.jdk.plage>[17,18)</argos.jdk.plage>
      </properties>
    </profile>
    <!-- Avis de licence des dépendances livrées (décisions F3 révisée par G1, G2 et G3 du porteur du
         projet, 2026-11-19 ; ADR-0021 points 4 et 6). Le build de l'image Docker (Dockerfile, étage
         « server ») exécute ce profil. Hors du cycle « mvn verify » : le but makeBom du plugin CycloneDX
         se déclare « requiresOnline » et refuse le mode hors ligne (« mvn -o »). Commande dédiée :
           mvn -B -f argos-server/pom.xml -P licences validate
         Elle produit target/bom.json (dépendances compile et runtime, sans les tests), puis lance
         scripts/verifier-licences-serveur.mjs (Node.js), qui en tire target/THIRD-PARTY.txt et fait
         échouer le build sur une licence absente ou non admise. -->
    <profile>
      <id>licences</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>${cyclonedx-plugin.version}</version>
            <executions>
              <execution>
                <id>inventaire-licences</id>
                <phase>validate</phase>
                <goals>
                  <goal>makeBom</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <projectType>application</projectType>
              <outputFormat>json</outputFormat>
              <outputName>bom</outputName>
              <includeCompileScope>true</includeCompileScope>
              <includeRuntimeScope>true</includeRuntimeScope>
              <includeProvidedScope>false</includeProvidedScope>
              <includeSystemScope>false</includeSystemScope>
              <includeTestScope>false</includeTestScope>
              <includeLicenseText>false</includeLicenseText>
              <skipAttach>true</skipAttach>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-plugin.version}</version>
            <executions>
              <execution>
                <id>verification-licences</id>
                <phase>validate</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>node</executable>
                  <arguments>
                    <argument>${project.basedir}/../scripts/verifier-licences-serveur.mjs</argument>
                    <argument>${project.build.directory}/bom.json</argument>
                    <argument>--depot</argument>
                    <argument>${settings.localRepository}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
