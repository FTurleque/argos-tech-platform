# Copier en .env et adapter. Ce fichier .env n'est jamais versionné.
# Chaque variable lue par Argos ou par compose.yaml figure ici (EXP-07, scripts/verifier-configuration.mjs) ;
# une ligne commentée « # NOM=valeur » montre un réglage facultatif et son défaut.

# Base de données (ADR-0035) : un compte par usage, aucun superutilisateur pour les applications.
# Les quatre mots de passe sont obligatoires (Compose refuse de démarrer sans eux) : longs, distincts, jamais versionnés.
# Ils servent à la création des rôles, au premier démarrage du volume PostgreSQL.
ARGOS_DB_NAME=argos
ARGOS_DB_PORT=5432
# Superutilisateur d'administration : initialisation, sauvegarde, restauration.
# ARGOS_DB_ADMIN_USER=argos_admin
ARGOS_DB_ADMIN_PASSWORD=
# Propriétaire de la base Argos : applique les migrations au démarrage.
# ARGOS_DB_OWNER=argos
ARGOS_DB_OWNER_PASSWORD=
# Rôle de connexion d'Argos : requêtes de l'application, soumises à la RLS.
# ARGOS_DB_USER=argos_connexion
ARGOS_DB_PASSWORD=
# Compte de Keycloak (profil « idp-local »), propriétaire de la seule base keycloak.
# ARGOS_KEYCLOAK_DB_USER=keycloak
ARGOS_KEYCLOAK_DB_PASSWORD=
# Adresse JDBC de la base, construite par défaut sur le service postgres du projet.
# ARGOS_DB_URL=jdbc:postgresql://postgres:5432/argos

# Accès à Argos.
#   127.0.0.1 : depuis la machine seule (PC) ou via le reverse proxy de DSM (NAS)
#   0.0.0.0   : depuis le réseau local ou le VPN
ARGOS_BIND=127.0.0.1
ARGOS_PORT=8080
# Adresse publique d'Argos, telle que l'ouvre le navigateur, sans « / » final : début des liens des e-mails et
# adresse de retour de la connexion déclarée au client argos-ui du royaume livré (profil « idp-local »).
# Par exemple http://192.168.1.20:8080 depuis un autre poste, ou https://argos.exemple.fr derrière le reverse
# proxy de DSM. Défaut : http://localhost:8080 (le port publié ARGOS_PORT).
ARGOS_PUBLIC_URL=
# Étiquette de l'image construite.
# ARGOS_VERSION=local

# Fournisseur d'identité OIDC (Keycloak auto-hébergé, ADR-0027) — obligatoire.
#   URL du royaume, par exemple https://auth.exemple.fr/realms/argos
ARGOS_OIDC_URL=
ARGOS_OIDC_CLIENT_ID=argos-server
#   Émetteur public : adresse du royaume telle que la joint le navigateur et que la portent les jetons. L'IHM la lit
#   au démarrage et la politique de sécurité du contenu la nomme. Par défaut ARGOS_OIDC_URL ; à régler quand le
#   serveur joint le royaume par une adresse interne (profil « idp-local »).
# ARGOS_OIDC_ISSUER_PUBLIC=
# Audience attendue dans les jetons d'accès.
# ARGOS_OIDC_AUDIENCE=argos-server
# E-mail vérifié du premier administrateur plateforme (créé sans invitation).
ARGOS_ADMIN_EMAIL=

# Keycloak fourni par compose.yaml, sans fournisseur d'identité existant : « docker compose --profile idp-local up -d --build ».
# Avec lui : ARGOS_OIDC_URL=http://keycloak:8080/realms/argos ; le royaume « argos » est importé au premier démarrage
# avec un seul compte (ARGOS_ADMIN_EMAIL, mot de passe provisoire ci-dessous, à changer à la première connexion).
# Avec ce profil, ARGOS_ADMIN_EMAIL, ARGOS_ADMIN_MOT_DE_PASSE_INITIAL et ARGOS_KEYCLOAK_ADMIN_MOT_DE_PASSE sont
# obligatoires : sans l'une d'elles, Keycloak s'arrête en la nommant, sans importer le royaume (EXP-08).
# L'import n'a lieu qu'une fois : changer ces valeurs ensuite ne modifie ni le compte ni le royaume.
ARGOS_ADMIN_MOT_DE_PASSE_INITIAL=
ARGOS_KEYCLOAK_ADMIN_MOT_DE_PASSE=
# Avec ce profil, l'émetteur public est l'adresse de Keycloak vue par le navigateur :
#   ARGOS_OIDC_ISSUER_PUBLIC=http://localhost:8180/realms/argos depuis l'hôte (valeur à poser avec ARGOS_OIDC_URL) ;
#   depuis un autre poste : ARGOS_KEYCLOAK_BIND=0.0.0.0, ARGOS_KEYCLOAK_PUBLIC_URL=http://<adresse-du-nas>:8180 et
#   ARGOS_OIDC_ISSUER_PUBLIC=http://<adresse-du-nas>:8180/realms/argos (docs/deploiement/synology-et-pc.md).
# Le mot de passe provisoire du compte administrateur compte au moins 12 caractères (politique du royaume livré).
# ARGOS_KEYCLOAK_ADMIN=admin
# ARGOS_KEYCLOAK_PORT=8180
# ARGOS_KEYCLOAK_BIND=127.0.0.1
# ARGOS_KEYCLOAK_PUBLIC_URL=http://localhost:8180
# ARGOS_KEYCLOAK_VERSION=26.7.4

# E-mails (alertes, résumés, invitations) : relais SMTP, celui de DSM sur le NAS. STARTTLS exigé par défaut.
# ARGOS_MAIL_FROM=argos@localhost
# ARGOS_SMTP_HOST=localhost
# ARGOS_SMTP_PORT=587
# ARGOS_SMTP_STARTTLS=REQUIRED
# ARGOS_SMTP_TIMEOUT=PT10S
# ARGOS_SMTP_USER=
ARGOS_SMTP_PASSWORD=

# Forges : jetons facultatifs en lecture seule (GitLab « read_api », GitHub à granularité fine).
ARGOS_GITLAB_TOKEN=
ARGOS_GITHUB_TOKEN=

# Planifications : expressions cron Quartz au fuseau ARGOS_ALERTES_FUSEAU ; « off » désactive la tâche.
# ARGOS_ALERTES_FUSEAU=Europe/Paris
# ARGOS_INGESTION_PLANIFICATION_CADENCE=1h
# ARGOS_INVENTORY_IMPORT_CRON=0 0 3 * * ?
# ARGOS_RESUME_QUOTIDIEN_CRON=0 0 8 * * ?
# ARGOS_RESUME_HEBDOMADAIRE_CRON=0 0 8 ? * MON
# ARGOS_RADAR_CRON=0 0 6 * * ?
# ARGOS_ENRICHISSEMENT_RELANCE_CRON=0 20 * * * ?
# ARGOS_ACTIVITE_PURGE_CRON=0 30 4 * * ?
# ARGOS_ARTISTE_COLLECTE_CRON=0 0 5 * * ?
# ARGOS_ARTISTE_RAPPELS_CRON=0 0 7 * * ?
# ARGOS_REGLEMENTAIRE_COLLECTE_CRON=0 30 6 * * ?
# ARGOS_REGLEMENTAIRE_RAPPELS_CRON=0 15 7 * * ?
# Archives JORF de la DILA (veille réglementaire).
# ARGOS_JORF_URL=https://echanges.dila.gouv.fr/OPENDATA/JORF

# Dimensionnement (DS1522+ : 8 Go ; docs/deploiement/synology-et-pc.md, « Dimensionnement du NAS »).
# Plafonds mémoire : 4,75 Gio au total avec les profils « ia » et « idp-local », au moins 3 Go laissés à DSM.
ARGOS_MEM_LIMIT=1g
ARGOS_DB_MEM_LIMIT=512m
# ARGOS_KEYCLOAK_MEM_LIMIT=768m
# ARGOS_OLLAMA_MEM_LIMIT=2560m
# Connexions : la somme des pools d'Argos et de Keycloak reste sous max_connections, avec une marge
# pour les migrations, l'administration et la sauvegarde (EXP-11).
# ARGOS_DB_MAX_CONNECTIONS=40
# ARGOS_DB_POOL_MAX_SIZE=10
# ARGOS_KEYCLOAK_DB_POOL_MAX_SIZE=10
# ARGOS_DB_SHARED_BUFFERS=128MB
# ARGOS_DB_WORK_MEM=4MB

# Sauvegardes (scripts/sauvegarder-base.sh, scripts/restaurer-base.sh) : dossier et archives conservées par base.
ARGOS_BACKUP_DIR=./sauvegardes
ARGOS_BACKUP_KEEP=14

TZ=Europe/Paris

# Passerelle IA facultative (encadrer-appels-ia) : modèle local Ollama, démarré par
# « docker compose --profile ia up -d », puis activé par ARGOS_IA_ACTIVE=true (désactivé par défaut).
# Sans lui, Argos fonctionne sans IA.
# ARGOS_IA_ACTIVE=true
# ARGOS_OLLAMA_URL=http://ollama:11434
# ARGOS_IA_MODELE=qwen2.5:1.5b
# ARGOS_IA_DELAI=PT60S
# ARGOS_IA_PLAFOND_JOUR=1000
# ARGOS_IA_QUOTA_ESPACE_JOUR=100
# ARGOS_IA_QUOTA_COMPTE_JOUR=20
# Analyse complémentaire de la corrélation (noms de projets transmis au modèle) : désactivée par défaut.
# ARGOS_IA_ANALYSE_CORRELATION=false
# ARGOS_OLLAMA_VERSION=0.40.17
# ARGOS_OLLAMA_KEEP_ALIVE=10m
